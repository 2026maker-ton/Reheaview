{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "public",
  "env": {
    "TTS_PROVIDER": "elevenlabs",
    "GEMINI_LIVE_ACK": "true",
    "GEMINI_REAL_DATA_ACK": "true",
    "GEMINI_GROUNDING_ACK": "true",
    "CLAUDE_LIVE_ACK": "true",
    "CLAUDE_REAL_DATA_ACK": "true",
    "CLAUDE_BASE_URL": "https://api.anthropic.com/v1",
    "CLAUDE_MODEL": "claude-haiku-5-5",
    "CLAUDE_WRITER_MODEL": "claude-haiku-5-5",
    "CLAUDE_API_VERSION": "2023-06-01",
    "GROQ_LIVE_ACK": "true",
    "GROQ_REAL_DATA_ACK": "true",
    "ELEVENLABS_LIVE_ACK": "true",
    "ELEVENLABS_REAL_DATA_ACK": "true"
  },
  "functions": {
    "api/handler.js": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net; script-src 'self'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self'; frame-src 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/handler?__p=:path*"
    }
  ]
}
