{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:intervu:schemas:personas.v2",
  "title": "Intervu Persona Roles Only",
  "description": "Persona role, evaluation lens and communication style only. Questions and question-generation rules are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "locale",
    "status",
    "purpose",
    "persona_policy",
    "global_guardrails",
    "personas",
    "recommended_combinations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "product": {
      "type": "string",
      "const": "Intervu"
    },
    "locale": {
      "type": "string",
      "const": "ko-KR"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed_configuration",
        "active_configuration",
        "deprecated"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "persona_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_real_person",
        "claims_real_university_affiliation",
        "claims_official_admissions_authority",
        "may_impersonate_named_professor",
        "may_decide_admission_outcome",
        "may_generate_questions",
        "may_generate_follow_up_questions",
        "may_invent_facts",
        "description"
      ],
      "properties": {
        "is_real_person": {
          "const": false
        },
        "claims_real_university_affiliation": {
          "const": false
        },
        "claims_official_admissions_authority": {
          "const": false
        },
        "may_impersonate_named_professor": {
          "const": false
        },
        "may_decide_admission_outcome": {
          "const": false
        },
        "may_generate_questions": {
          "const": false
        },
        "may_generate_follow_up_questions": {
          "const": false
        },
        "may_invent_facts": {
          "const": false
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "global_guardrails": {
      "$ref": "#/$defs/stringArray"
    },
    "personas": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/persona"
      }
    },
    "recommended_combinations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/combination"
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "short_name",
        "availability",
        "role_summary",
        "purpose",
        "assessment_lens",
        "communication_style",
        "behavior_rules",
        "prohibited_behaviors",
        "selection_tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "short_name": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "type": "string",
          "enum": [
            "active",
            "conditional_disabled",
            "disabled"
          ]
        },
        "role_summary": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "assessment_lens": {
          "$ref": "#/$defs/stringArray"
        },
        "communication_style": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tone",
            "manner",
            "avoid_manner"
          ],
          "properties": {
            "tone": {
              "type": "string",
              "minLength": 1
            },
            "manner": {
              "type": "string",
              "minLength": 1
            },
            "avoid_manner": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "behavior_rules": {
          "$ref": "#/$defs/stringArray"
        },
        "prohibited_behaviors": {
          "$ref": "#/$defs/stringArray"
        },
        "selection_tags": {
          "$ref": "#/$defs/stringArray"
        },
        "activation_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "enabled_by_default": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "const": "faculty_research_lens"
              }
            }
          },
          "then": {
            "required": [
              "activation_requirements",
              "enabled_by_default"
            ],
            "properties": {
              "availability": {
                "const": "conditional_disabled"
              },
              "enabled_by_default": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "combination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "persona_ids",
        "condition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "persona_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
